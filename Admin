-- 4. ОБРАБОТЧИК ЧАТ-КОМАНД И GUI-МЕНЮ
-- ------------------------------------------
LocalPlayer.Chatted:Connect(function(msg)
    if msg:sub(1, #_G.Prefix) ~= _G.Prefix then 
        SuggestFrame.Visible = false
        return 
    end
    
    local args = string.split(msg:sub(#_G.Prefix + 1), " ")
    local cmd = args[1]:lower()

    -- Меню подсказок при вводе
    if cmd == "give" then
        SuggestFrame.Visible = true
        SuggestTitle.Text = " 🎒 Варианты ;give:"
        SuggestText.Text = ";give medkit [кол-во]\n;give flashlight\n;give key\n;give syringe\n;give pill"
    elseif cmd == "summon" or cmd == "spawn" then
        SuggestFrame.Visible = true
        SuggestTitle.Text = " 👾 Варианты ;summon:"
        SuggestText.Text = ";summon mimic [комната]\n;summon bed [комната]\n;summon eyes [комната]\n;summon stalker [комната]"
    elseif cmd == "nps" or cmd == "npc" then
        SuggestFrame.Visible = true
        SuggestTitle.Text = " 👤 Сюжетные НПС (;nps):"
        SuggestText.Text = ";nps barney (Ресепшн)\n;nps ratthew [комната]\n;nps ron [комната]\n❌ Доктор заблокирован!"
    elseif cmd == "cmds" or cmd == "help" then
        SuggestFrame.Visible = true
        SuggestTitle.Text = " 📜 Список команд Zenith:"
        SuggestText.Text = ";sanity | ;money [сумма <= 10000]\n;give [предмет] [кол-во]\n;summon [моб] [комната]\n;nps [нпс] | ;spawnall\n;revive [ник] | ;autorevive\n;heal | ;autoheal | ;autoaccept"
    else
        SuggestFrame.Visible = false
    end

    -- ВЫПОЛНЕНИЕ КОМАНД

    -- Рассудок и Деньги
    if cmd == "sanity" or cmd == "infsanity" then
        _G.InfSanity = not _G.InfSanity
        print("[ZENITH]: Бесконечный рассудок: " .. tostring(_G.InfSanity))
    elseif cmd == "money" or cmd == "cash" or cmd == "m" then
        local amount = tonumber(args[2]) or 0
        if amount > 10000 then amount = 10000 end
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        if leaderstats then
            for _, stat in pairs(leaderstats:GetChildren()) do
                if stat.Name:lower():find("money") or stat.Name:lower():find("cash") then stat.Value = stat.Value + amount end
            end
        end

    -- Выдача предметов
    elseif cmd == "give" or cmd == "item" then
        if args[2] then
            local count = tonumber(args[3]) or 1
            for _, obj in pairs(game:GetDescendants()) do
                if obj:IsA("Tool") and obj.Name:lower():find(args[2]:lower()) then
                    for i = 1, count do obj:Clone().Parent = LocalPlayer.Backpack end
                    break
                end
            end
        end

    -- Спавн монстров
    elseif cmd == "summon" or cmd == "spawn" then
        if args[2] then
            local targetPos = GetRoomPosition(args[3]) or (LocalPlayer.Character and (LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)).Position)
            for _, obj in pairs(game:GetDescendants()) do
                if obj:IsA("Model") and obj.Name:lower():find(args[2]:lower()) then
                    local clone = obj:Clone()
                    clone:PivotTo(CFrame.new(targetPos))
                    clone.Parent = Workspace
                    break
                end
            end
        end

    -- Спавн сюжетников (Барни, Рэттью, Рон)
    elseif cmd == "nps" or cmd == "npc" then
        if args[2] then
            local npcName = args[2]:lower()
            for _, banned in ipairs(BannedNPCs) do if npcName:find(banned) then return end end
            local searchTarget = AllowedStoryNPCs[npcName] or npcName
            local targetPos = GetRoomPosition(args[3]) or (LocalPlayer.Character and (LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)).Position)
            for _, obj in pairs(game:GetDescendants()) do
                if obj:IsA("Model") and obj.Name:lower():find(searchTarget) then
                    local clone = obj:Clone()
                    clone:PivotTo(CFrame.new(targetPos))
                    clone.Parent = Workspace
                    break
                end
            end
        end

    -- Остальной функционал
    elseif cmd == "spawnall" then
        local char = LocalPlayer.Character
        if char then
            for i, name in ipairs({"mimic", "bed", "eyes", "stalker"}) do
                local pos = char.HumanoidRootPart.Position + Vector3.new((i - 2.5) * 8, 0, -10)
                for _, obj in pairs(game:GetDescendants()) do
                    if obj:IsA("Model") and obj.Name:lower():find(name) then
                        local c = obj:Clone()
                        c:PivotTo(CFrame.new(pos))
                        c.Parent = Workspace
                        break
                    end
                end
            end
        end
    elseif cmd == "nocd" then _G.NoCooldown = not _G.NoCooldown
    elseif cmd == "revive" then if args[2] then for _, p in pairs(Players:GetPlayers()) do if p.Name:lower():find(args[2]:lower()) then RevivePlayer(p) end end end
    elseif cmd == "autorevive" then _G.AutoRevive = not _G.AutoRevive
    elseif cmd == "heal" then for _, obj in pairs(Workspace:GetDescendants()) do if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and not IsAnomaly(obj) then HealPatient(obj) end end
    elseif cmd == "autoheal" then _G.AutoHeal = not _G.AutoHeal
    elseif cmd == "accept" then ProcessAccept()
    elseif cmd == "autoaccept" then _G.AutoAccept = not _G.AutoAccept
    end
end)

