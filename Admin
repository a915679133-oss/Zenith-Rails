-- 2. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ------------------------------------------
local function GetRoomPosition(roomName)
    if not roomName then return nil end
    roomName = roomName:lower()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name == roomName or name == "room" .. roomName or name == "room_" .. roomName then
                if obj:IsA("BasePart") then return obj.Position end
                if obj:IsA("Model") then return obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position end
            end
        end
    end
    return nil
end

local function IsAnomaly(patientModel)
    if not patientModel then return false end
    local name = patientModel.Name:lower()
    if name:find("mimic") or name:find("skinwalker") or name:find("anomaly") or name:find("eyes") then return true end
    if patientModel:GetAttribute("IsAnomaly") == true or patientModel:FindFirstChild("IsAnomaly") then return true end
    return false
end

local function HealPatient(patient)
    for _, rem in pairs(ReplicatedStorage:GetDescendants()) do
        if rem:IsA("RemoteEvent") and (rem.Name:lower():find("heal") or rem.Name:lower():find("examine") or rem.Name:lower():find("treat")) then
            rem:FireServer(patient)
        end
    end
end

local function ProcessAccept()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj:FindFirstChild("Humanoid") or obj.Name:lower():find("patient")) and obj ~= LocalPlayer.Character then
            if IsAnomaly(obj) then
                print("[ZENITH]: Обнаружена АНОМАЛИЯ! Закрываем окно.")
                for _, rem in pairs(ReplicatedStorage:GetDescendants()) do
                    if rem:IsA("RemoteEvent") and (rem.Name:lower():find("window") or rem.Name:lower():find("close") or rem.Name:lower():find("shutter")) then
                        rem:FireServer(true)
                    end
                end
            else
                print("[ZENITH]: Человек. Принимаем.")
                for _, rem in pairs(ReplicatedStorage:GetDescendants()) do
                    if rem:IsA("RemoteEvent") and (rem.Name:lower():find("accept") or rem.Name:lower():find("checkin")) then
                        rem:FireServer(obj)
                    end
                end
            end
        end
    end
end

local function RevivePlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    for _, rem in pairs(ReplicatedStorage:GetDescendants()) do
        if rem:IsA("RemoteEvent") and (rem.Name:lower():find("revive") or rem.Name:lower():find("resurrect")) then
            rem:FireServer(targetPlayer.Character)
        end
    end
end

-- ------------------------------------------
-- 3. ПОСТОЯННЫЕ ФОНОВЫЕ ЦИКЛЫ
-- ------------------------------------------
RunService.Stepped:Connect(function()
    -- Бесконечный рассудок
    if _G.InfSanity then
        local sanityVal = LocalPlayer:FindFirstChild("Sanity") 
            or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Sanity"))
            or (LocalPlayer:FindFirstChild("stats") and LocalPlayer.stats:FindFirstChild("Sanity"))
        if sanityVal then sanityVal.Value = 100 end
        if LocalPlayer.Character and LocalPlayer.Character:GetAttribute("Sanity") then
            LocalPlayer.Character:SetAttribute("Sanity", 100)
        end
    end

    -- Убрать КД инструментов
    if _G.NoCooldown then
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                tool:SetAttribute("Cooldown", 0)
                if tool:FindFirstChild("Cooldown") then tool.Cooldown.Value = 0 end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(1) do
        if _G.AutoRevive then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum and (hum.Health <= 0 or p.Character:FindFirstChild("Downed")) then RevivePlayer(p) end
                end
            end
        end
        if _G.AutoHeal then
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and not IsAnomaly(obj) and obj ~= LocalPlayer.Character then HealPatient(obj) end
            end
        end
        if _G.AutoAccept then ProcessAccept() end
    end
end)

